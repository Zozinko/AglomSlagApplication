# Скопировать в Soft/.env: один файл для Docker и IDE.
# В Docker адрес БД задаётся как postgres; для IDE оставить localhost.
# По одному значению в строке, в кавычках.
DB_HOST='localhost'
DB_PORT='5432'
DB_USER='postgres'
DB_PASSWORD=''
JWT_ISSUER='aglomslag-local'
JWT_AUDIENCE='aglomslag-clients'
JWT_SIGNING_KEY=''
JWT_ACCESS_SECONDS='300'
JWT_CLOCK_SKEW_SECONDS='5'
JWT_REFRESH_DAYS='7'
# Эти аккаунты создаются при первом запуске. Перезапуск не меняет их пароли.
DEMO_BOOTSTRAP='true'
DEMO_USER_EMAIL='user@example.invalid'
DEMO_USER_PASSWORD=''
DEMO_ADMIN_EMAIL='admin@example.invalid'
DEMO_ADMIN_PASSWORD=''
# Только для ручного создания аккаунта или сброса пароля; обычному запуску не нужны.
BOOTSTRAP_EMAIL=''
BOOTSTRAP_PASSWORD=''
BOOTSTRAP_NAME=''
TARGET_USER_ID=''
NEW_PASSWORD=''
