# Copy to Soft/.env. Shared by Compose and host/IDE startup.
# Compose sets DB_HOST=postgres inside its network; host access uses localhost.
# Values are literal, single-line; outer single/double quotes are removed.
DB_HOST='localhost'
DB_PORT='5432'
DB_USER='postgres'
DB_PASSWORD=''
JWT_ISSUER='aglomslag-local'
JWT_AUDIENCE='aglomslag-clients'
JWT_SIGNING_KEY=''
JWT_ACCESS_SECONDS='300'
JWT_CLOCK_SKEW_SECONDS='5'
JWT_REFRESH_DAYS='7'
# Created automatically on first startup; existing passwords survive restart.
DEMO_BOOTSTRAP='true'
DEMO_USER_EMAIL='user@example.invalid'
DEMO_USER_PASSWORD=''
DEMO_ADMIN_EMAIL='admin@example.invalid'
DEMO_ADMIN_PASSWORD=''
# Optional operator commands; clear after use.
BOOTSTRAP_EMAIL=''
BOOTSTRAP_PASSWORD=''
BOOTSTRAP_NAME=''
TARGET_USER_ID=''
NEW_PASSWORD=''
